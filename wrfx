#!/usr/bin/env python3
"""Run the former WRFxPy shell commands through one executable."""

import os
from pathlib import Path
import runpy
import shlex
import subprocess
import sys


INSTALL_DIR = Path(__file__).resolve().parent
SOURCE_DIR = INSTALL_DIR / "src"


COMMANDS = (
    "apply_fmda",
    "clamp2mesh",
    "cleanup",
    "convert_geotiff",
    "csv2kmz",
    "domain_bbox",
    "domain_setup",
    "earthdata",
    "execute_wrf",
    "fill_subgrid",
    "forecast",
    "grib_tool",
    "hrrr_cycler",
    "level0_retr",
    "make_job_file",
    "make_kmz",
    "postprocess",
    "process_output",
    "process_sat_output",
    "process_tiffs_output",
    "recover_catalog",
    "retrieve_arcgis",
    "retrieve_gribs",
    "retrieve_hdfs",
    "retrieve_landfire",
    "retrieve_sat",
    "rtma_cycler",
    "simple_forecast",
    "ssh_command",
    "ssh_shuttle",
)


def run_script(script, arguments, work_dir=None):
    """Run an existing Python command entry point."""
    old_argv = sys.argv
    old_cwd = Path.cwd()
    sys.path.insert(0, str(SOURCE_DIR))
    if work_dir is not None:
        os.chdir(str(work_dir))
    sys.argv = [str(SOURCE_DIR / script)] + [str(value) for value in arguments]
    try:
        runpy.run_path(sys.argv[0], run_name="__main__")
    finally:
        sys.argv = old_argv
        os.chdir(str(old_cwd))
        if sys.path[0] == str(SOURCE_DIR):
            sys.path.pop(0)
    return 0


def require_arguments(command, arguments, count=None):
    if count is None and arguments:
        return
    if count is not None and len(arguments) == count:
        return
    usage = {
        "clamp2mesh": "wrfx clamp2mesh wrffile [x y]",
        "execute_wrf": "wrfx execute_wrf job_id",
        "fill_subgrid": "wrfx fill_subgrid wrf_path",
        "forecast": "wrfx forecast input.json",
        "process_output": "wrfx process_output job_id",
        "process_sat_output": "wrfx process_sat_output job_id",
        "process_tiffs_output": "wrfx process_tiffs_output job_id",
    }[command]
    raise SystemExit("usage: " + usage)


def run_convert_geotiff(arguments):
    caller_dir = Path.cwd()
    converted = list(arguments[:4])
    for index in (0, 1):
        if index < len(converted) and not os.path.isabs(converted[index]):
            converted[index] = str(caller_dir / converted[index])
    return run_script("geo/convert_geotiff.py", converted, INSTALL_DIR)


def run_csv2kmz(arguments):
    input_path = arguments[0] if arguments else ""
    output_path = arguments[1] if len(arguments) > 1 else ""
    run_script("vis/csv2kml.py", [input_path, "doc.kml"], INSTALL_DIR)
    try:
        os.remove(str(INSTALL_DIR / output_path))
    except FileNotFoundError:
        pass
    return subprocess.call(["zip", "-9", output_path, "doc.kml"], cwd=str(INSTALL_DIR))


def run_retrieve_arcgis(arguments):
    source = SOURCE_DIR / "fire_init/acq_arcgis.py"
    command = "source ~/.bashrc; conda activate arcgis; cd %s; PYTHONPATH=src python %s \"$@\"" % (
        shlex.quote(str(INSTALL_DIR)), shlex.quote(str(source)))
    return subprocess.call(["bash", "-lc", command, "wrfx-retrieve-arcgis"] + arguments)


def dispatch(command, arguments):
    if command == "apply_fmda":
        return run_script("fmda/fuel_moisture_da.py", arguments[:2])
    if command == "clamp2mesh":
        require_arguments(command, arguments)
        return run_script("clamp2mesh.py", arguments, INSTALL_DIR)
    if command == "cleanup":
        return run_script("cleanup.py", arguments[:2], INSTALL_DIR)
    if command == "convert_geotiff":
        return run_convert_geotiff(arguments)
    if command == "csv2kmz":
        return run_csv2kmz(arguments)
    if command == "domain_bbox":
        return run_script("tests/test_domains.py", arguments[:1], INSTALL_DIR)
    if command == "domain_setup":
        return run_script("wrf/wps_domains.py", arguments[:3])
    if command == "earthdata":
        return run_script("ingest/earthdata.py", arguments, INSTALL_DIR)
    if command == "execute_wrf":
        require_arguments(command, arguments)
        return run_script("execute_wrf.py", arguments[:1], INSTALL_DIR)
    if command == "fill_subgrid":
        require_arguments(command, arguments)
        return run_script("fill_subgrid.py", arguments[:1], INSTALL_DIR)
    if command == "forecast":
        require_arguments(command, arguments)
        return run_script("forecast.py", arguments[:1], INSTALL_DIR)
    if command == "grib_tool":
        return run_script("ingest/grib_file.py", arguments[:4])
    if command == "hrrr_cycler":
        print(Path.cwd())
        return run_script("hrrr_cycler.py", arguments)
    if command == "level0_retr":
        return run_script("ingest/retrieve_hdfs.py", arguments[:8])
    if command == "make_job_file":
        return run_script("make_job_file.py", arguments[:1], INSTALL_DIR)
    if command == "make_kmz":
        return run_script("make_kmz.py", [" ".join(arguments)], INSTALL_DIR)
    if command == "postprocess":
        return run_script("vis/postprocess.py", arguments[:3])
    if command == "process_output":
        require_arguments(command, arguments)
        return run_script("process_output.py", arguments[:1], INSTALL_DIR)
    if command == "process_sat_output":
        require_arguments(command, arguments, 1)
        run_script("process_sat_output.py", arguments, INSTALL_DIR)
        return run_script("make_kmz.py", arguments, INSTALL_DIR)
    if command == "process_tiffs_output":
        require_arguments(command, arguments, 1)
        return run_script("process_tiffs.py", arguments, INSTALL_DIR)
    if command == "recover_catalog":
        return run_script("recover_catalog.py", arguments, INSTALL_DIR)
    if command == "retrieve_arcgis":
        return run_retrieve_arcgis(arguments)
    if command == "retrieve_gribs":
        return run_script("ingest/retrieve_gribs.py", arguments[:4], INSTALL_DIR)
    if command == "retrieve_hdfs":
        return run_script("ingest/retrieve_hdfs.py", arguments)
    if command == "retrieve_landfire":
        return run_script("ingest/retrieve_landfire.py", arguments, INSTALL_DIR)
    if command == "retrieve_sat":
        return run_script("ingest/retrieve_sat.py", arguments, INSTALL_DIR)
    if command == "rtma_cycler":
        print(Path.cwd())
        return run_script("rtma_cycler.py", arguments)
    if command == "simple_forecast":
        return run_script("simple_forecast.py", [])
    if command == "ssh_command":
        return run_script("ssh_command.py", arguments, INSTALL_DIR)
    if command == "ssh_shuttle":
        return run_script("ssh_shuttle.py", arguments[:4])
    raise SystemExit("unknown command: %s" % command)


def main(argv=None):
    arguments = list(sys.argv[1:] if argv is None else argv)
    if not arguments or arguments[0] in ("-h", "--help", "help"):
        print("usage: wrfx command [arguments]")
        print("commands: " + " ".join(COMMANDS))
        return 0 if arguments else 1
    return dispatch(arguments[0], arguments[1:])


if __name__ == "__main__":
    sys.exit(main())
